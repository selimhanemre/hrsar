---
import Base from '../../layouts/Base.astro';
import { site } from '../../config';
import { services } from '../../content/services';

const service = services.find(s => s.slug === 'repairs-emergency');
if (!service) throw new Error('Repairs & Emergency service not found');
---

<Base title={`24/7 Emergency HVAC Repair — ${site.name}`}>

  <!-- ─── Urgent Hero ─── -->
  <section class="relative bg-gradient-to-br from-ember-500 to-accent-600 pt-28 lg:pt-36 pb-16 sm:pb-20">
    <!-- Subtle pattern overlay -->
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="p" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="1.5" fill="white"/></pattern></defs><rect width="100%" height="100%" fill="url(#p)"/></svg>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <!-- Urgent badge -->
        <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm rounded-full px-4 py-2 mb-5">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
          </span>
          <span class="text-white text-sm font-semibold">24/7 Emergency Service Available Now</span>
        </div>

        <h1 class="text-white font-display font-bold text-3xl sm:text-4xl lg:text-5xl leading-tight">
          {service.heroTitle}
        </h1>
        <p class="mt-4 text-white/90 text-base sm:text-lg leading-relaxed">
          {service.heroBody}
        </p>

        <div class="flex flex-wrap gap-3 mt-7">
          <a
            href={site.phoneHref}
            class="bg-white hover:bg-neutral-100 text-ember-500 font-bold text-lg px-9 py-4 rounded-full transition-colors inline-flex items-center gap-2 shadow-lg"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call Now — {site.phone}
          </a>
          <a
            href="/hrsar/contact"
            class="border-2 border-white/60 hover:border-white text-white font-semibold text-base px-7 py-3.5 rounded-full transition-colors"
          >
            Request Service
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Urgency Band ─── -->
  <section class="bg-brand-950 py-8 sm:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl sm:text-3xl font-display font-bold text-accent-500">24/7</p>
          <p class="text-xs text-white/60 mt-1">Availability</p>
        </div>
        <div>
          <p class="text-2xl sm:text-3xl font-display font-bold text-accent-500">&lt;60m</p>
          <p class="text-xs text-white/60 mt-1">Avg Response</p>
        </div>
        <div>
          <p class="text-2xl sm:text-3xl font-display font-bold text-accent-500">~90%</p>
          <p class="text-xs text-white/60 mt-1">Fixed in 1 Visit</p>
        </div>
        <div>
          <p class="text-2xl sm:text-3xl font-display font-bold text-accent-500">Upfront</p>
          <p class="text-xs text-white/60 mt-1">Pricing</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Why Us ─── -->
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink mb-6">
            When Your System Goes Down, We're Already En Route
          </h2>
          <p class="text-neutral-600 leading-relaxed mb-8 font-manrope">
            We know what it feels like to be without heat in January or AC in August. That's why we staff emergency trucks around the clock — because your comfort can't wait until Monday.
          </p>
          <ul class="space-y-4">
            {service.whyUs.map(point => (
              <li class="flex gap-3 items-start">
                <svg class="w-5 h-5 text-accent-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-sm text-neutral-700 leading-relaxed">{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-amber-50 rounded-2xl p-8 lg:p-10 border border-amber-200/60">
          <div class="flex items-center gap-3 mb-5">
            <span class="text-2xl">🚨</span>
            <h3 class="text-xl font-display font-bold text-ink">Emergency Service</h3>
          </div>
          <p class="text-neutral-600 text-sm leading-relaxed mb-6 font-manrope">
            Available 24/7/365 — including holidays. No overtime surcharges. No surprise invoices. Just honest, fast repairs.
          </p>
          <div class="space-y-3">
            <a
              href={site.phoneHref}
              class="block w-full text-center bg-accent-500 hover:bg-accent-600 text-white font-semibold py-3.5 rounded-full transition-colors"
            >
              Call {site.phone} Now
            </a>
            <a
              href="/hrsar/contact"
              class="block w-full text-center border-2 border-brand-500 text-brand-500 hover:bg-brand-50 font-semibold py-3.5 rounded-full transition-colors"
            >
              Schedule Non-Urgent Repair
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Features ─── -->
  <section class="py-16 sm:py-20 lg:py-24 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-ink text-center mb-10">
        What We Cover
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.features.map(feature => (
          <div class="bg-white rounded-2xl p-6 border border-neutral-200/60">
            <p class="text-sm text-neutral-700 leading-relaxed">{feature}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Final CTA ─── -->
  <section class="bg-brand-950 py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-white">
        {service.ctaTitle}
      </h2>
      <p class="mt-3 text-base text-white/70 font-manrope">
        We answer every call. Day or night, weekday or holiday — we're here.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a
          href={site.phoneHref}
          class="bg-accent-500 hover:bg-accent-600 text-white font-semibold text-lg px-9 py-4 rounded-full transition-colors inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call {site.phone}
        </a>
        <a
          href="/hrsar/contact"
          class="border-2 border-white/40 hover:border-white/70 text-white font-semibold text-lg px-9 py-4 rounded-full transition-colors"
        >
          Get a Free Estimate
        </a>
      </div>
    </div>
  </section>
</Base>
