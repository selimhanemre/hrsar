---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { trustedBy } from '../content/trustedBy';
import { services } from '../content/services';

const heroTitle = 'Your family-owned HVAC crew in Little Rock — 24/7.';
const heroSub = 'Licensed, insured, bonded. Free estimates. Serving all of Arkansas since 2017.';
const trustChips = ['Licensed', 'Insured', 'Bonded', 'Manufacturer Certified', 'Fully Stocked Trucks', 'Warranties'];

const whyBullets = [
  { icon: '🕐', title: '24/7 Emergency Service', desc: 'We answer at midnight and on holidays — because breakdowns don\'t keep office hours.' },
  { icon: '💰', title: 'Free Estimates', desc: 'Honest pricing with no obligation. We\'ll tell you exactly what it\'ll cost before we start.' },
  { icon: '📋', title: 'Licensed, Insured & Bonded', desc: 'Your property is protected. We carry full coverage and all required Arkansas licenses.' },
  { icon: '🏭', title: 'Manufacturer Certified', desc: 'Our techs are factory-trained and certified by the major brands you see in your building.' },
  { icon: '🚛', title: 'Fully Stocked Trucks', desc: 'We carry common parts on every truck — most repairs finish in a single visit.' },
  { icon: '🛡️', title: 'Warranties', desc: 'Parts and labor warranties on every job. We stand behind the work we do.' },
  { icon: '👨‍👩‍👧‍👦', title: 'Family-Owned Since 2017', desc: 'We treat your property like it\'s our own. Every customer is a neighbor.' },
];

const recentProjects = [
  { src: '/assets/truck-1.webp', alt: 'HRS service truck on a job' },
  { src: '/assets/truck-2.webp', alt: 'HRS crew at a commercial install' },
  { src: '/assets/truck-3.webp', alt: 'HRS truck in the field' },
];

const serviceAreaCities = site.serviceArea;
---

<Base title={`${site.name} — Arkansas HVAC & Refrigeration`}>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 1. HERO                                    -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="relative bg-brand-950 overflow-hidden" style="background-color: #072436;">
    <!-- Background image -->
    <img
      src="/assets/hero-home.webp"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
      aria-hidden="true"
    />

    <!-- Directional gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-l from-brand-950/90 via-brand-950/45 to-transparent"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-[85vh] flex flex-col justify-center">
      <div class="max-w-xl lg:max-w-lg mt-16 lg:mt-0">
        <!-- Eyebrow chip -->
        <div class="inline-flex items-center gap-1.5 border border-accent-500/60 rounded-full px-3.5 py-1.5 mb-5">
          <span class="text-accent-500 text-lg leading-none" aria-hidden="true">🔥</span>
          <span class="text-accent-500 text-xs sm:text-sm font-semibold tracking-wide">24/7 Emergency Service · Arkansas-wide</span>
        </div>

        <!-- H1 -->
        <h1 class="text-white font-display font-bold text-3xl sm:text-4xl md:text-5xl lg:text-[44px] leading-tight tracking-tight">
          {heroTitle}
        </h1>

        <!-- Subhead -->
        <p class="mt-4 text-white/85 text-base sm:text-lg lg:text-xl font-manrope">
          {heroSub}
        </p>

        <!-- Dual CTA -->
        <div class="flex flex-wrap gap-3 mt-7">
          <a
            href={site.phoneHref}
            class="bg-accent-500 hover:bg-accent-600 text-white font-semibold text-base px-7 py-3.5 rounded-full transition-colors inline-flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call {site.phone}
          </a>
          <a
            href="/contact"
            class="border-2 border-white/40 hover:border-white/70 text-white font-semibold text-base px-7 py-3.5 rounded-full transition-colors"
          >
            Free Estimate
          </a>
        </div>

        <!-- Trust chips -->
        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-6 text-white/60 text-xs sm:text-sm">
          {trustChips.map((chip, i) => (
            <span class="flex items-center gap-1.5">
              {i > 0 && <span class="text-white/30">·</span>}
              {chip}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Truck card overlapping bottom edge (desktop) -->
    <div class="hidden lg:block absolute -bottom-16 -left-4 xl:-left-16 z-20">
      <div class="relative rounded-2xl overflow-hidden shadow-2xl max-w-sm lg:max-w-md" style="border: 3px solid rgba(255,255,255,0.15);">
        <img
          src="/assets/truck-1.webp"
          alt="HRS service truck — out on a call in Sherwood"
          class="w-full h-auto"
          loading="lazy"
        />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-950/80 to-transparent p-4 pt-8">
          <p class="text-white/90 text-xs sm:text-sm font-manrope">
            Out on a call in Sherwood — trucks stocked for common issues.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 2. TRUSTED-BY STRIP                        -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="bg-neutral-50 border-y border-neutral-200/60 py-8 sm:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.15em] text-neutral-400 mb-6">
        Trusted by businesses across Arkansas
      </p>
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-8 lg:gap-10">
        {trustedBy.map(brand => (
          <div class="flex items-center justify-center w-[120px] sm:w-[140px]">
            {brand.textOnly ? (
              <span class="text-[11px] sm:text-xs font-semibold text-neutral-600 text-center leading-tight">{brand.name}</span>
            ) : (
              <img
                src={`/assets/logos/${brand.logo}`}
                alt={`${brand.name} — trusted by HRS`}
                class="max-h-[32px] sm:max-h-[38px] w-auto opacity-60 hover:opacity-100 transition-opacity"
                width="120"
                height="38"
              />
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 3. WHY HRS                                 -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12 lg:mb-16">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-ink">
          Why Central Arkansas trusts HRS
        </h2>
        <p class="mt-3 text-base sm:text-lg text-neutral-600 font-manrope">
          We're your neighbors. We show up on time, price honestly, and fix it right the first time. That's the family-business way.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {whyBullets.map(bullet => (
          <div class="bg-neutral-50 rounded-2xl p-6 lg:p-8 border border-neutral-200/60">
            <span class="text-2xl lg:text-3xl block mb-3">{bullet.icon}</span>
            <h3 class="text-lg font-display font-bold text-ink mb-2">{bullet.title}</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">{bullet.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 4. SERVICES (6 cards)                      -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-24 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-ink">
          Our Services
        </h2>
        <p class="mt-3 text-base sm:text-lg text-neutral-600 font-manrope">
          From emergency repairs to full commercial installs — we handle it all.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {services.map((svc) => (
          <a
            href={`/services/${svc.slug}`}
            class="group bg-white rounded-2xl p-6 lg:p-8 border border-neutral-200/60 hover:border-brand-500/30 hover:shadow-lg transition-all"
          >
            <span class="text-2xl lg:text-3xl block mb-4">{svc.icon}</span>
            <h3 class="text-lg font-display font-bold text-ink mb-2 group-hover:text-brand-500 transition-colors">
              {svc.title}
            </h3>
            <p class="text-sm text-neutral-600 leading-relaxed">{svc.description}</p>
            <span class="inline-block mt-4 text-brand-500 text-sm font-semibold group-hover:translate-x-1 transition-transform">
              Learn more →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 5. REVIEWS                                 -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <!-- Google rating line -->
        <div class="flex items-center justify-center gap-2 mb-2">
          <span class="text-3xl font-display font-bold text-ink">5.0</span>
          <span class="text-accent-500 text-2xl">★</span>
          <span class="text-neutral-500 text-sm">on</span>
          <a
            href={site.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-neutral-500 hover:text-brand-500 transition-colors text-sm font-medium"
          >
            Google
          </a>
        </div>
        <p class="text-neutral-400 text-xs">Verified by Google · {site.mapsUrl}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
        {[
          {
            name: 'Marcus Thompson',
            town: 'Little Rock',
            service: 'HVAC Installation',
            text: 'HRS replaced our entire office system and the team was fantastic from start to finish. They explained every option, stayed on budget, and had us up and running in two days. I\'d recommend them to anyone.',
          },
          {
            name: 'Patricia Nguyen',
            town: 'Sherwood',
            service: 'Emergency Repair',
            text: 'Our AC gave out at 9 PM on a Saturday. Called HRS and they had a tech at our door within an hour. He fixed the compressor and we were cool by midnight. Worth every penny for the peace of mind.',
          },
          {
            name: 'Dale Richardson',
            town: 'Benton',
            service: 'Commercial Refrigeration',
            text: 'We\'ve used HRS for our restaurant refrigeration for three years now. They respond fast, their pricing is fair, and they treat our business like it matters. Best HVAC crew in Central Arkansas.',
          },
          {
            name: 'Stephanie Cole',
            town: 'Maumelle',
            service: 'Preventative Maintenance',
            text: 'The maintenance plan has saved us money and headaches. HRS comes out twice a year, catches small issues before they become big ones, and always leaves the place clean. We feel taken care of.',
          },
        ].map((review, i) => (
          <div key={i} class="bg-neutral-50 rounded-2xl p-6 lg:p-8 border border-neutral-200/60">
            <div class="flex items-center gap-1 mb-3">
              {[...Array(5)].map((_, j) => (
                <span key={j} class="text-accent-500">★</span>
              ))}
            </div>
            <p class="text-sm text-neutral-700 leading-relaxed mb-5 font-manrope">&ldquo;{review.text}&rdquo;</p>
            <div>
              <p class="text-sm font-semibold text-ink">{review.name}</p>
              <p class="text-xs text-neutral-500">{review.town} · {review.service}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="text-center text-[10px] text-neutral-400 mt-4">
        * These are sample reviews included for design purposes. Real Google reviews can be found via the link above.
      </p>

      <div class="text-center mt-8">
        <a
          href="/reviews"
          class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-semibold text-base px-7 py-3.5 rounded-full transition-colors"
        >
          Share Your Experience
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 6. RECENT PROJECTS PHOTO STRIP             -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-24 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-ink">
            Recent Projects
          </h2>
          <p class="mt-2 text-base text-neutral-600 font-manrope">
            Real jobs, real customers across Arkansas.
          </p>
        </div>
        <a
          href="/projects"
          class="text-brand-500 font-semibold text-sm hover:underline shrink-0"
        >
          View all projects →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 lg:gap-6">
        {recentProjects.map(proj => (
          <div class="rounded-2xl overflow-hidden border border-neutral-200/60 group">
            <img
              src={proj.src}
              alt={proj.alt}
              class="w-full h-48 sm:h-56 lg:h-64 object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 7. SERVICE AREA                            -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-ink">
          Proudly Serving All of Arkansas
        </h2>
        <p class="mt-3 text-base sm:text-lg text-neutral-600 font-manrope">
          From Little Rock to the Ozarks, our trucks are on the road every day. We cover the entire state for both residential and commercial service.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-3 mt-10">
        {serviceAreaCities.map(city => (
          <span class="bg-neutral-100 text-neutral-700 text-sm font-medium px-4 py-2 rounded-full">
            {city}
          </span>
        ))}
        <span class="bg-brand-100 text-brand-700 text-sm font-medium px-4 py-2 rounded-full">
          + All of Arkansas
        </span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- 8. FINAL CTA BAND                          -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="bg-brand-950 py-16 sm:py-20 lg:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-white">
        Need help? We're just a phone call away.
      </h2>
      <p class="mt-3 text-base sm:text-lg text-white/70 font-manrope">
        Free estimates. 24/7 emergency service. No job too big or small.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a
          href={site.phoneHref}
          class="bg-accent-500 hover:bg-accent-600 text-white font-semibold text-lg px-9 py-4 rounded-full transition-colors inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call {site.phone}
        </a>
        <a
          href="/contact"
          class="border-2 border-white/40 hover:border-white/70 text-white font-semibold text-lg px-9 py-4 rounded-full transition-colors"
        >
          Get a Free Estimate
        </a>
      </div>
    </div>
  </section>

</Base>
